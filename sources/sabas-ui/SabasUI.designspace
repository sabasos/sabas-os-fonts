<?xml version="1.0" encoding="UTF-8"?>
<!--
  SabasUI.designspace
  Registered axes only: wght wdth opsz GRAD slnt. Every master sits directly on its
  own axis extreme; the parametric axes of brief §5.2 need avar2, which fontc does
  not emit, so they are not part of this design space.

  wght  Thin Light Regular Medium SemiBold Bold ExtraBold Black Ultra
  wdth  Condensed(75) Extended(125)      opsz  Caption(10) Display(32)
  GRAD  GradMin(-200) GradMax(150)       slnt  Oblique(-10)
-->
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight"       minimum="100"  default="400"  maximum="1000"/>
    <axis tag="wdth" name="Width"        minimum="75"   default="100"  maximum="125"/>
    <axis tag="opsz" name="Optical Size" minimum="10"   default="16"   maximum="32"/>
    <axis tag="GRAD" name="Grade"        minimum="-200" default="0"    maximum="150"/>
    <axis tag="slnt" name="Slant"        minimum="-10"  default="0"    maximum="0"/>
  </axes>

  <sources>
    <source filename="SabasUI-Thin.ufo" familyname="Sabas UI" stylename="Thin">
      <location><dimension name="Weight" xvalue="100"/></location>
    </source>
    <source filename="SabasUI-Light.ufo" familyname="Sabas UI" stylename="Light">
      <location><dimension name="Weight" xvalue="300"/></location>
    </source>
    <source filename="SabasUI-Regular.ufo" familyname="Sabas UI" stylename="Regular">
      <location>
        <dimension name="Weight"       xvalue="400"/>
        <dimension name="Width"        xvalue="100"/>
        <dimension name="Optical Size" xvalue="16"/>
        <dimension name="Grade"        xvalue="0"/>
        <dimension name="Slant"        xvalue="0"/>
      </location>
    </source>
    <source filename="SabasUI-Medium.ufo" familyname="Sabas UI" stylename="Medium">
      <location><dimension name="Weight" xvalue="500"/></location>
    </source>
    <source filename="SabasUI-SemiBold.ufo" familyname="Sabas UI" stylename="SemiBold">
      <location><dimension name="Weight" xvalue="600"/></location>
    </source>
    <source filename="SabasUI-Bold.ufo" familyname="Sabas UI" stylename="Bold">
      <location><dimension name="Weight" xvalue="700"/></location>
    </source>
    <source filename="SabasUI-ExtraBold.ufo" familyname="Sabas UI" stylename="ExtraBold">
      <location><dimension name="Weight" xvalue="800"/></location>
    </source>
    <source filename="SabasUI-Black.ufo" familyname="Sabas UI" stylename="Black">
      <location><dimension name="Weight" xvalue="900"/></location>
    </source>
    <source filename="SabasUI-Ultra.ufo" familyname="Sabas UI" stylename="Ultra">
      <location><dimension name="Weight" xvalue="1000"/></location>
    </source>
    <source filename="SabasUI-Condensed.ufo" familyname="Sabas UI" stylename="Condensed">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Width" xvalue="75"/>
      </location>
    </source>
    <source filename="SabasUI-Extended.ufo" familyname="Sabas UI" stylename="Extended">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Width" xvalue="125"/>
      </location>
    </source>
    <source filename="SabasUI-Caption.ufo" familyname="Sabas UI" stylename="Caption">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Optical Size" xvalue="10"/>
      </location>
    </source>
    <source filename="SabasUI-Display.ufo" familyname="Sabas UI" stylename="Display">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Optical Size" xvalue="32"/>
      </location>
    </source>
    <source filename="SabasUI-GradMin.ufo" familyname="Sabas UI" stylename="GradMin">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Grade" xvalue="-200"/>
      </location>
    </source>
    <source filename="SabasUI-GradMax.ufo" familyname="Sabas UI" stylename="GradMax">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Grade" xvalue="150"/>
      </location>
    </source>
    <source filename="SabasUI-Oblique.ufo" familyname="Sabas UI" stylename="Oblique">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Slant" xvalue="-10"/>
      </location>
    </source>
  </sources>

  <instances>
    <instance familyname="Sabas UI" stylename="Thin" filename="../../fonts/SabasUI-Thin.ttf" name="Sabas UI Thin">
      <location><dimension name="Weight" xvalue="100"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Light" filename="../../fonts/SabasUI-Light.ttf" name="Sabas UI Light">
      <location><dimension name="Weight" xvalue="300"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Regular" filename="../../fonts/SabasUI-Regular.ttf" name="Sabas UI Regular">
      <location><dimension name="Weight" xvalue="400"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Medium" filename="../../fonts/SabasUI-Medium.ttf" name="Sabas UI Medium">
      <location><dimension name="Weight" xvalue="500"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="SemiBold" filename="../../fonts/SabasUI-SemiBold.ttf" name="Sabas UI SemiBold">
      <location><dimension name="Weight" xvalue="600"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Bold" filename="../../fonts/SabasUI-Bold.ttf" name="Sabas UI Bold">
      <location><dimension name="Weight" xvalue="700"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="ExtraBold" filename="../../fonts/SabasUI-ExtraBold.ttf" name="Sabas UI ExtraBold">
      <location><dimension name="Weight" xvalue="800"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Black" filename="../../fonts/SabasUI-Black.ttf" name="Sabas UI Black">
      <location><dimension name="Weight" xvalue="900"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Ultra" filename="../../fonts/SabasUI-Ultra.ttf" name="Sabas UI Ultra">
      <location><dimension name="Weight" xvalue="1000"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Thin Oblique" name="Sabas UI Thin Oblique">
      <location><dimension name="Weight" xvalue="100"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Light Oblique" name="Sabas UI Light Oblique">
      <location><dimension name="Weight" xvalue="300"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Regular Oblique" name="Sabas UI Regular Oblique">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Medium Oblique" name="Sabas UI Medium Oblique">
      <location><dimension name="Weight" xvalue="500"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="SemiBold Oblique" name="Sabas UI SemiBold Oblique">
      <location><dimension name="Weight" xvalue="600"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Bold Oblique" name="Sabas UI Bold Oblique">
      <location><dimension name="Weight" xvalue="700"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="ExtraBold Oblique" name="Sabas UI ExtraBold Oblique">
      <location><dimension name="Weight" xvalue="800"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Black Oblique" name="Sabas UI Black Oblique">
      <location><dimension name="Weight" xvalue="900"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Ultra Oblique" name="Sabas UI Ultra Oblique">
      <location><dimension name="Weight" xvalue="1000"/><dimension name="Slant" xvalue="-10"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Condensed Regular" name="Sabas UI Condensed Regular">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Width" xvalue="75"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Extended Regular" name="Sabas UI Extended Regular">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Width" xvalue="125"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Condensed Bold" name="Sabas UI Condensed Bold">
      <location><dimension name="Weight" xvalue="700"/><dimension name="Width" xvalue="75"/></location>
    </instance>
    <instance familyname="Sabas UI" stylename="Extended Bold" name="Sabas UI Extended Bold">
      <location><dimension name="Weight" xvalue="700"/><dimension name="Width" xvalue="125"/></location>
    </instance>
  </instances>

</designspace>

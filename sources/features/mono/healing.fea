# healing.fea - generated by tools/build_mono_ufo.py, do not edit.
# Backtrack and lookahead classes include the variants, so a decision made on the
# original neighbours is the same after they have been substituted.
@NARROW_V = [i j l t f r I one];
@NARROW_V_W1 = [i.wide1 j.wide1 l.wide1 t.wide1 f.wide1 r.wide1 I.wide1 one.wide1];
@NARROW_V_W2 = [i.wide2 j.wide2 l.wide2 t.wide2 f.wide2 r.wide2 I.wide2 one.wide2];
@NARROW_ALL = [i j l t f r I one period comma semicolon colon quotesingle quotedbl grave exclam bar parenleft parenright bracketleft bracketright braceleft braceright slash backslash @NARROW_V_W1 @NARROW_V_W2];
@WIDE_V = [m w M W at percent ampersand];
@WIDE_V_N1 = [m.narrow1 w.narrow1 M.narrow1 W.narrow1 at.narrow1 percent.narrow1 ampersand.narrow1];
@WIDE_ALL = [m w M W at percent ampersand @WIDE_V_N1];

lookup healing {
    sub @NARROW_ALL @NARROW_V' @NARROW_ALL by @NARROW_V_W2;
    sub @NARROW_ALL @NARROW_V' by @NARROW_V_W1;
    sub @NARROW_V' @NARROW_ALL by @NARROW_V_W1;
    sub @WIDE_ALL @WIDE_V' @WIDE_ALL by @WIDE_V_N1;
} healing;

feature calt { lookup healing; } calt;

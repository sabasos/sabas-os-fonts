# alternates.fea - generated by tools/finalize.py, do not edit.
# ss01: single-storey a, for a and every accented a.
@ss01_base = [a aacute abreve acircumflex adieresis agrave amacron aogonek aring atilde];
@ss01_alt = [a.ss01 aacute.ss01 abreve.ss01 acircumflex.ss01 adieresis.ss01 agrave.ss01 amacron.ss01 aogonek.ss01 aring.ss01 atilde.ss01];
feature ss01 {
    sub @ss01_base by @ss01_alt;
} ss01;

<?xml version="1.0" encoding="UTF-8"?>
<!--
  SabasM.designspace - Sabas Mono
  Registered axes only, each master on its own axis extreme (fontc does not emit the
  avar2 that hidden parametric axes would need). Fixed 600-unit advance throughout and
  no kern table. The opsz axis of the brief has no masters yet, so it is not declared.

  wght Light(200) Regular(400) Bold(800)   GRAD GradMin(-200) GradMax(150)   slnt Oblique(-9)
-->
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="200"  default="400" maximum="800"/>
    <axis tag="GRAD" name="Grade"  minimum="-200" default="0"   maximum="150"/>
    <axis tag="slnt" name="Slant"  minimum="-9"   default="0"   maximum="0"/>
  </axes>

  <sources>
    <source filename="SabasM-Light.ufo" familyname="Sabas Mono" stylename="Light">
      <location><dimension name="Weight" xvalue="200"/></location>
    </source>
    <source filename="SabasM-Regular.ufo" familyname="Sabas Mono" stylename="Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Grade"  xvalue="0"/>
        <dimension name="Slant"  xvalue="0"/>
      </location>
    </source>
    <source filename="SabasM-Bold.ufo" familyname="Sabas Mono" stylename="Bold">
      <location><dimension name="Weight" xvalue="800"/></location>
    </source>
    <source filename="SabasM-GradMin.ufo" familyname="Sabas Mono" stylename="GradMin">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Grade" xvalue="-200"/></location>
    </source>
    <source filename="SabasM-GradMax.ufo" familyname="Sabas Mono" stylename="GradMax">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Grade" xvalue="150"/></location>
    </source>
    <source filename="SabasM-Oblique.ufo" familyname="Sabas Mono" stylename="Oblique">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Slant" xvalue="-9"/></location>
    </source>
  </sources>

  <instances>
    <instance familyname="Sabas Mono" stylename="Light" name="Sabas Mono Light">
      <location><dimension name="Weight" xvalue="200"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="Regular" name="Sabas Mono Regular">
      <location><dimension name="Weight" xvalue="400"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="Medium" name="Sabas Mono Medium">
      <location><dimension name="Weight" xvalue="500"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="SemiBold" name="Sabas Mono SemiBold">
      <location><dimension name="Weight" xvalue="600"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="Bold" name="Sabas Mono Bold">
      <location><dimension name="Weight" xvalue="700"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="ExtraBold" name="Sabas Mono ExtraBold">
      <location><dimension name="Weight" xvalue="800"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="Regular Oblique" name="Sabas Mono Regular Oblique">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Slant" xvalue="-9"/></location>
    </instance>
    <instance familyname="Sabas Mono" stylename="Bold Oblique" name="Sabas Mono Bold Oblique">
      <location><dimension name="Weight" xvalue="700"/><dimension name="Slant" xvalue="-9"/></location>
    </instance>
  </instances>
</designspace>
